---
layout: default
---
<div class="post">
  {% if page.collection == 'projects' %}
    {% if page.category == 'publication' %}
      <a class="back-link" href="{{ '/publications/' | relative_url }}"><i class="fa-solid fa-arrow-left"></i> Publications</a>
    {% else %}
      <a class="back-link" href="{{ '/projects/' | relative_url }}"><i class="fa-solid fa-arrow-left"></i> Projects</a>
    {% endif %}
  {% endif %}
  <header class="post-header{% if page.header_search %} post-header-search{% endif %}">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.header_search %}
      {% include bib_search.liquid %}
    {% endif %}
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article{% if page.collection == 'projects' %} class="project-post"{% endif %}>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
